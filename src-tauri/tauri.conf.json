{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/cpp",
      "bin/dlls",
      "misc/*.bin",
      "misc/*.json",
      "misc/*.txt",
      "misc/*.txtg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "TotkBits",
  "mainBinaryName": "TotkBits",
  "version": "1.0.1",
  "identifier": "com.solidlink.totkbits",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "TotkBits v1.0.1",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true,
        "useHttpsScheme": true
      }
    ]
  }
}
